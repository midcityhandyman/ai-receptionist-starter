# Copy to .env and export it in your shell. Every value is optional.
# With nothing set, the mock voice provider is used and no keys are needed.

# Voice provider: "mock" (offline, default) or "http" (generic hosted platform).
VOICE_PROVIDER=mock

# Only needed when VOICE_PROVIDER=http. Never commit a real key.
VOICE_API_KEY=
VOICE_API_BASE_URL=https://voice.example.com/v1

# When set, every POST to the server must send this in the X-Tool-Secret header.
TOOL_SHARED_SECRET=

# Business details. The defaults are synthetic.
COMPANY_NAME=Example Home Services
SERVICE_ZIPS=00101,00102,00103,00104
HANDOFF_NUMBER=+15555550100
ON_CALL_NUMBER=+15555550199

# Where python -m receptionist.server listens.
HOST=127.0.0.1
PORT=8080
